"""
A Python module implemented in Rust.
"""

from _typeshed import Incomplete
from collections.abc import Sequence
from typing import final

@final
class Fft2Planner:
    @staticmethod
    def forward_planner(nrows: int, ncols: int) -> Fft2Planner: ...
    @staticmethod
    def inverse_planner(nrows: int, ncols: int) -> Fft2Planner: ...
    def ncols(self, /) -> int: ...
    def nrows(self, /) -> int: ...
    def process_numpy_inplace(self, /, array: Incomplete) -> None: ...

@final
class InplacePropagation:
    """
    The `InplacePropagation` object implements the 4 operators described in Goodman's
    "Introduction to Fourier Optics", Chapter 5. Namely:
     - Multiplying by a `quadratic`-phase exponential,
     - `scaling` by a constant,
     - The `fourier` transformation,
     - And `freespace` propagation.
    """
    def __new__(cls, /, wavelength: float, wavesize_xy: tuple[float, float], shape: tuple[int, int]) -> InplacePropagation: ...
    def fourier(self, /, array: Incomplete, forward: bool) -> None: ...
    def freespace(self, /, array: Incomplete, d: float) -> None: ...
    def quadratic(self, /, array: Incomplete, c: float) -> None: ...
    def scaling(self, /, array: Incomplete, b: float) -> None: ...

def fresnel_transfer_inplace(array: Incomplete, dz: float, wavelength: float, wavesize: Sequence[float]) -> None: ...
